# All values are read on the server only. Never prefix them with NEXT_PUBLIC_.

# Base URL of the Spring Boot API.
API_BASE_URL=http://localhost:8080

# Public URL of this Next.js app (used for the OAuth callback and sign-out redirect).
APP_URL=http://localhost:3000

# Amazon Cognito (see README: "Cognito setup").
COGNITO_REGION=us-east-1
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Cognito domain without a trailing slash, e.g. https://duelyard.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=

# Public WebSocket endpoint of the Spring Boot API (not a secret).
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8080/ws
